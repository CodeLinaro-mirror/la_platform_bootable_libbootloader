    rustc_flags = [
        "-A",
        "unused_macros",
        "-A",
        "redundant_semicolons",
        "-A",
        "mismatched_lifetime_syntaxes",
    ],
)

gbl_rust_crate_repository(
    name = "itertools",
    features = [
        "default",
        "use_std",
        "use_alloc",
