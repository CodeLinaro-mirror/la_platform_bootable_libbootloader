"""GBL."""

module(name = "gbl")

bazel_dep(
    name = "bazel_skylib",
)
bazel_dep(
    name = "googletest",
)
bazel_dep(
    name = "platforms",
)
bazel_dep(
    name = "rules_cc",
)
bazel_dep(
    name = "rules_license",
)
bazel_dep(
    name = "rules_pkg",
)
bazel_dep(
    name = "rules_python",
)
bazel_dep(
    name = "rules_shell",
)
bazel_dep(
    name = "rules_rust",
)
bazel_dep(
    name = "rules_rust_bindgen",
)

gbl_repositories_ext = use_extension(
    "//integration/aosp_uefi-gbl-mainline:workspace.bzl",
    "gbl_repositories_ext",
)
use_repo(gbl_repositories_ext, "llvm_linux_x86_64_prebuilts")
use_repo(gbl_repositories_ext, "rust_prebuilts")

local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

gbl_new_local_repository = use_repo_rule("//toolchain:gbl_new_local_repository.bzl", "gbl_new_local_repository")

gbl_rust_crate_repository = use_repo_rule("//toolchain:gbl_new_local_repository.bzl", "gbl_rust_crate_repository")

gbl_new_local_repository(
    name = "linux_x86_64_sysroot",
    build_file = "@gbl//libboot:BUILD.linux_x86_64_sysroot.bazel",
    path = "prebuilts/kernel-build-tools/sysroots/x86_64-unknown-linux-musl",
)

gbl_new_local_repository(
    name = "bindgen",
    build_file_content = """exports_files(["bindgen"])""",
    path = "prebuilts/clang-tools/linux-x86/bin",
)

gbl_new_local_repository(
    name = "libfdt_c",
    build_file = "@gbl//libfdt:BUILD.libfdt_c.bazel",
    # The upstream build rule almost works for us, but we want to inject
    # license information and instrumentation hooks.
    exclude_files = ["BUILD.bazel"],
    path = "external/dtc",
)

gbl_new_local_repository(
    name = "libufdt_c",
    build_file = "@gbl//libfdt:BUILD.libufdt_c.bazel",
    path = "external/libufdt",
)

gbl_new_local_repository(
    name = "arm_trusted_firmware",
    build_file = "@gbl//libboot/aarch64_cache_helper:BUILD.arm_trusted_firmware.bazel",
    path = "external/arm-trusted-firmware",
)

gbl_new_local_repository(
    name = "avb",
    build_file = "@gbl//libavb:BUILD.avb.bazel",
    path = "external/avb",
)

gbl_new_local_repository(
    name = "vmm",
    build_file_content = """exports_files(glob(["**/*"]))""",
    exist_marker_path = "repo_exists",
    path = "prebuilts/vmm",
)

gbl_rust_crate_repository(
    name = "uuid",
    path = "external/rust/android-crates-io/crates/uuid",
)

gbl_rust_crate_repository(
    name = "spin",
    features = [
        "mutex",
        "spin_mutex",
    ],
    path = "external/rust/android-crates-io/crates/spin",
    rustc_flags = [
        "-A",
        "unused_imports",
        "-A",
        "mismatched_lifetime_syntaxes",
