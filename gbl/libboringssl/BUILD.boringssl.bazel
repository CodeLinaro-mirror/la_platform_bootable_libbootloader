load(
    "@boringssl//:gen/sources.bzl",
    "bcm_internal_headers",
    "crypto_headers",
    "crypto_internal_headers",
    "crypto_sources",
)
load("@gbl//toolchain:gbl_toolchain.bzl", "link_static_cc_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
)

crypto_sources = [
    "@gbl//libboringssl:bcm.cpp",
    "crypto/sha/sha1.cc",
    "crypto/sha/sha256.cc",
    "crypto/sha/sha512.cc",
    "crypto/curve25519/curve25519.cc",
    "crypto/thread_none.cc",
]

cc_library(
    name = "libcrypto_c_baremetal",
    srcs = crypto_sources,
    hdrs = crypto_internal_headers + crypto_headers + bcm_internal_headers,
    copts = [
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-error=format",
        "-Xclang -target-feature",
        "-Xclang -sve",
        "-fvisibility=hidden",
        "-fno-lto",
        "-DOPENSSL_SMALL",
        "-DOPENSSL_NO_ASM",
        "-DANDROID_BAREMETAL",
        "-DBORINGSSL_IMPLEMENTATION",
        "-DBORINGSSL_SHARED_LIBRARY",
        "-DBORINGSSL_NO_STATIC_INITIALIZER",
    ],
    cxxopts = [
        "-Wall",
        "-Werror",
        "-std=c++17",
    ],
    includes = [
        "include",
        "src/include",
    ],
    deps = [
        "@gbl//libc:headers",
    ],
)

link_static_cc_library(
    name = "libcrypto_c_baremetal_static",
    cc_library = ":libcrypto_c_baremetal",
)
