load("@gbl//licensing:licenses.bzl", "generate_license")
load("@gbl//toolchain:gbl_workspace_util.bzl", "ANDROID_RUST_LINTS")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library")
load(
    ":src/gen/sources.bzl",
    "bcm_internal_headers",
    "bcm_sources",
    "bcm_sources_asm",
    "crypto_headers",
    "crypto_internal_headers",
    "crypto_sources",
    "crypto_sources_asm",
    "rust_bssl_crypto_sources",
)

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

generate_license(
    name = "license",
    package_name = "boringssl",
)

exports_files([
    "LICENSE",
    "src/rust/bssl-sys/wrapper.h",
    "src/rust/bssl-crypto/src/ecdsa.rs",
    "src/rust/bssl-crypto/src/ec.rs",
    "src/rust/bssl-crypto/src/scoped.rs",
])

boringssl_baremetal_copts = [
    "-DBORINGSSL_IMPLEMENTATION",
    "-DANDROID_BAREMETAL",
    "-DOPENSSL_SMALL",
    "-DOPENSSL_NO_FILESYSTEM",
    "-DOPENSSL_NO_POSIX_IO",
    "-DOPENSSL_NO_SOCK",
    "-DOPENSSL_NO_THREADS_CORRUPT_MEMORY_AND_LEAK_SECRETS_IF_THREADED",
    "-D_LIBCPP_PROVIDES_DEFAULT_RUNE_TABLE",
    "-std=c++17",
    "-fno-exceptions",
    "-fno-rtti",
    "-Wno-macro-redefined",
] + select({
    "@platforms//cpu:aarch64": [
        "-DOPENSSL_AARCH64",
        "-Xclang -target-feature",
        "-Xclang -sve",
    ],
    "@platforms//cpu:x86_64": [
        "-DOPENSSL_NO_ASM",
        "-DOPENSSL_X86_64",
        "-msse2",
    ],
    "//conditions:default": [
        "-DOPENSSL_NO_ASM",
    ],
})

cc_library(
    name = "crypto_asm",
    srcs = ["src/" + f for f in bcm_sources_asm + crypto_sources_asm],
    hdrs = ["src/" + f for f in crypto_headers],
    copts = boringssl_baremetal_copts,
    includes = ["src/include"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "crypto_baremetal",
    srcs = ["src/" + f for f in bcm_sources + crypto_sources],
    hdrs = ["src/" + f for f in crypto_headers + bcm_internal_headers + crypto_internal_headers] + ["src/rust/bssl-sys/wrapper.h"],
    copts = boringssl_baremetal_copts + [
        # This prevents BoringSsl from relying on Win32 specific libraries.
        # Since they are not readily available on baremetal.
        # And everything that is used would need to be implemented in GBL.
        "-U_WIN32",
    ],
    includes = [
        "src",
        "src/include",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":crypto_asm",
    ],
)

filegroup(
    name = "rust_bssl_crypto_sources",
    srcs = ["src/" + f for f in rust_bssl_crypto_sources],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "bssl_crypto",
    srcs = [":rust_bssl_crypto_sources"],
    crate_name = "bssl_crypto",
    crate_root = "src/rust/bssl-crypto/src/lib.rs",
    edition = "2021",
    rustc_flags = ANDROID_RUST_LINTS,
    visibility = ["//visibility:public"],
    deps = [
        "@gbl//libboringssl:bssl-sys",
    ],
)
